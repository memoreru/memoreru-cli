{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://memoreru.com/schemas/memoreru.json",
  "title": "Memoreru Manifest",
  "description": ".memoreru.json — ファイル名をキー、コンテンツメタデータを値とするマニフェスト",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSONスキーマURL（エディタ補完用）"
    }
  },
  "additionalProperties": {
    "$ref": "#/definitions/entry"
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["contentType"],
      "properties": {
        "contentId": {
          "type": "string",
          "description": "コンテンツID（初回push時に自動設定）"
        },
        "contentType": {
          "type": "string",
          "enum": [
            "folder",
            "page",
            "table",
            "slide",
            "view",
            "graph",
            "dashboard",
            "screen",
            "report",
            "workflow"
          ],
          "description": "コンテンツタイプ"
        },
        "title": {
          "type": "string",
          "description": "タイトル（省略時はファイル名から推定）"
        },
        "scope": {
          "type": "string",
          "enum": ["public", "team", "private"],
          "default": "private",
          "description": "公開範囲"
        },
        "teamId": {
          "type": "string",
          "description": "チームID（scope が team の場合に必要）"
        },
        "description": {
          "type": "string",
          "description": "説明文"
        },
        "descriptionExpanded": {
          "type": "boolean",
          "default": false,
          "description": "説明を展開して表示する"
        },
        "category": {
          "type": "string",
          "description": "カテゴリ名またはキー（例: テクノロジー, technology）"
        },
        "label": {
          "type": "string",
          "description": "ラベル"
        },
        "icon": {
          "description": "アイコン（絵文字 or 画像）。null でクリア。",
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "emoji"],
              "properties": {
                "type": { "const": "emoji" },
                "emoji": { "type": "string", "description": "絵文字グリフ（例: 📝）" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "const": "image" },
                "path": { "type": "string", "description": "ローカル画像パス（push 時にアップロード）" },
                "fileId": { "type": "string", "description": "アップロード済みファイルID（path の代替）" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "slug": {
          "type": "string",
          "description": "カスタムURLスラッグ（有料プラン）"
        },
        "language": {
          "type": "string",
          "default": "en",
          "description": "言語コード（ISO 639-1: ja, en 等）"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "タグ名の配列"
        },
        "persons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "人物名の配列"
        },
        "thumbnail": {
          "type": "string",
          "description": "サムネイル画像のローカル相対パス（例: ./images/thumb.png）"
        },
        "sources": {
          "type": "string",
          "description": "参考文献"
        },
        "extensions": {
          "type": "array",
          "description": "拡張設定（Extensions: スタイル/スクリプト/カスタム処理）をローカルファイルで管理。push でファイル内容を反映、pull でファイルへ書き出し。",
          "items": {
            "type": "object",
            "required": ["type", "file"],
            "properties": {
              "type": {
                "enum": ["style", "script", "custom_process"],
                "description": "種別（style=CSS / script=JS / custom_process=イベント駆動JS）"
              },
              "file": {
                "type": "string",
                "description": "コードファイルの相対パス（例: scripts/on-create.js, styles/row-coloring.css）"
              },
              "title": { "type": "string", "description": "表示タイトル（未指定はファイル名のベース名）" },
              "isDisabled": { "type": "boolean", "description": "無効化" },
              "executionOrder": { "type": "string", "description": "実行順序" },
              "triggers": {
                "type": "array",
                "items": { "type": "string" },
                "description": "実行トリガー（customProcess のみ）"
              },
              "extensionId": { "type": "string", "description": "push 後に自動で書き戻される" }
            },
            "additionalProperties": false
          }
        },
        "datetime": {
          "type": ["object", "null"],
          "description": "日時（単一オブジェクト）。例: { \"start\": \"2026-01-15\", \"end\": null, \"type\": \"date\" }",
          "properties": {
            "start": { "type": ["string", "null"], "description": "開始日時（例: 2026, 2026-01, 2026-01-15, 2026-01-15T10:00:00）" },
            "end": { "type": ["string", "null"], "description": "終了日時（start と同じ形式）" },
            "type": { "type": ["string", "null"], "enum": ["year", "month", "date", "datetime", null], "description": "日時精度" }
          },
          "additionalProperties": false
        },
        "location": {
          "type": ["object", "null"],
          "description": "場所（単一オブジェクト）。area1/area2 は登録地点の id（tenant はサーバが解決）。",
          "properties": {
            "area1": { "type": ["string", "null"], "description": "地点 id（国レベル）" },
            "area2": { "type": ["string", "null"], "description": "地点 id（地域レベル）" },
            "lat": { "type": ["number", "null"], "description": "緯度（WGS84）" },
            "lng": { "type": ["number", "null"], "description": "経度（WGS84）" },
            "address": { "type": ["string", "null"], "description": "住所" },
            "name": { "type": ["string", "null"], "description": "場所名" }
          },
          "additionalProperties": false
        },
        "systemType": {
          "type": "string",
          "description": "システム種別（内部用）"
        },
        "customOrder": {
          "type": "number",
          "description": "表示順（カスタムソート用）"
        },
        "matchColumn": {
          "type": "string",
          "description": "table: 照合列 upsert に使う列（列名 or column_id）"
        },
        "templateGroupId": {
          "type": "string",
          "description": "テンプレートグループ ID（テンプレート配布用）"
        },
        "templateGroupTenantId": {
          "type": "string",
          "description": "テンプレートグループの tenant_id"
        },
        "parentContentId": {
          "type": "string",
          "description": "親フォルダの contentId"
        },
        "publishStatus": {
          "type": "string",
          "enum": ["draft", "published"],
          "default": "published",
          "description": "公開ステータス"
        },
        "scheduledAt": {
          "type": "string",
          "description": "予約公開日時（ISO 8601）"
        },
        "expiresAt": {
          "type": "string",
          "description": "公開期限（ISO 8601）"
        },
        "discovery": {
          "type": "string",
          "enum": ["listed", "unlisted", "profile"],
          "default": "listed",
          "description": "公開先（listed: 検索可能, unlisted: URL共有のみ, profile: プロフィールのみ）"
        },
        "accessLevel": {
          "type": "string",
          "enum": ["open", "login_required", "followers_only"],
          "default": "open",
          "description": "閲覧制限（open: 誰でも, login_required: ログインユーザー, followers_only: フォロワーのみ）"
        },
        "canEmbed": {
          "type": "boolean",
          "default": true,
          "description": "埋め込みを許可する"
        },
        "canAiCrawl": {
          "type": "boolean",
          "default": true,
          "description": "AIクローラーを許可する"
        },
        "hasPassword": {
          "type": "boolean",
          "default": false,
          "description": "パスワード保護"
        },
        "isSuspended": {
          "type": "boolean",
          "default": false,
          "description": "一時停止"
        },
        "isArchived": {
          "type": "boolean",
          "default": false,
          "description": "アーカイブ"
        },
        "isPinned": {
          "type": "boolean",
          "default": false,
          "description": "ピン留め"
        },
        "isLocked": {
          "type": "boolean",
          "default": false,
          "description": "編集ロック"
        },
        "autoSummary": {
          "type": "boolean",
          "default": false,
          "description": "要約を自動生成する"
        },
        "autoTranslate": {
          "type": "boolean",
          "default": false,
          "description": "翻訳版を自動生成する"
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type"],
            "properties": {
              "id": {
                "type": "string",
                "description": "カラムID（push後に自動書き戻し）"
              },
              "name": {
                "type": "string",
                "description": "カラム名"
              },
              "type": {
                "type": "string",
                "description": "データ型（string, number, date 等）"
              },
              "settings": {
                "type": "object",
                "description": "カラム設定（select 選択肢 / required / description 等）。name 照合で冪等反映される",
                "properties": {
                  "required": {
                    "type": "boolean",
                    "description": "入力必須"
                  },
                  "description": {
                    "type": "string",
                    "description": "カラムの説明"
                  },
                  "options": {
                    "type": "array",
                    "description": "select / multi_select の選択肢",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" },
                        "color": { "type": "string" },
                        "description": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "description": "テーブルのカラム定義（contentType が table の場合のみ。push後に自動書き戻し）"
        }
      },
      "additionalProperties": false
    }
  }
}
